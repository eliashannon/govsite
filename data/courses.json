{
  "courses": [
    {
      "id": "TRN-001",
      "title": "Initial Orientation",
      "shortDescription": "Learn organizational processes, responsibilities, and expectations.",
      "description": "This course introduces new personnel to organizational processes, responsibilities, and common workplace expectations.",
      "category": "Initial",
      "durationMinutes": 120,
      "difficulty": "Beginner",
      "prerequisites": [],
      "learningObjectives": ["Understand organizational responsibilities", "Recognize key workplace processes", "Identify appropriate support channels"],
      "version": "1.0",
      "modules": [
        {"id":"TRN-001-module-1","title":"Welcome and Responsibilities","order":1,"estimatedMinutes":30,"learningObjectives":["Explain the portal purpose","Identify core responsibilities"],"content":[{"type":"heading","level":2,"text":"Welcome"},{"type":"paragraph","text":"This orientation provides a common foundation for working effectively and safely."},{"type":"list","style":"unordered","items":["Know your responsibilities","Use approved procedures","Ask questions when information is unclear"]},{"type":"callout","variant":"info","title":"Key Point","text":"Clear communication supports reliable operations."}]},
        {"id":"TRN-001-module-2","title":"Processes and Procedures","order":2,"estimatedMinutes":40,"learningObjectives":["Locate important procedures","Describe a standard workflow"],"content":[{"type":"heading","level":2,"text":"Working with Procedures"},{"type":"paragraph","text":"Approved procedures help teams perform consistent work and reduce avoidable risk."},{"type":"list","style":"unordered","items":["Review current instructions","Follow the documented sequence","Record required follow-up"]},{"type":"link","text":"Open the course catalog","url":"required-training.html"}]},
        {"id":"TRN-001-module-3","title":"Support and Next Steps","order":3,"estimatedMinutes":50,"learningObjectives":["Identify support resources","Plan next required learning"],"content":[{"type":"heading","level":2,"text":"Getting Help"},{"type":"paragraph","text":"Use the Contact and Help resources when you need clarification or support."},{"type":"callout","variant":"info","title":"Next Step","text":"Complete this module to finish the orientation."}]}
      ]
    },
    {
      "id": "TRN-002",
      "title": "Annual Information Security",
      "shortDescription": "Build practical information-security awareness.",
      "description": "This course covers cybersecurity awareness and responsible information handling.",
      "category": "Mandatory",
      "durationMinutes": 60,
      "difficulty": "Beginner",
      "prerequisites": [],
      "learningObjectives": ["Identify common threats","Recognize suspicious messages","Apply safe information-handling practices"],
      "version": "1.0",
      "modules": [
        {"id":"TRN-002-module-1","title":"Introduction to Cybersecurity","order":1,"estimatedMinutes":15,"learningObjectives":["Define cybersecurity","Explain why awareness matters"],"content":[{"type":"heading","level":2,"text":"What Is Cybersecurity?"},{"type":"paragraph","text":"Cybersecurity is the practice of protecting systems, networks, and information from unauthorized access or misuse."},{"type":"list","style":"unordered","items":["Protect information","Reduce risk","Support reliable operations"]},{"type":"callout","variant":"info","title":"Key Point","text":"Every user contributes to organizational security."},{"type":"link","text":"Read official cybersecurity guidance","url":"https://www.cisa.gov/secure-our-world"},{"type":"image","src":"assets/shared/images/navsea%20logo.jpg","alt":"NAVSEA organizational logo"}]},
        {"id":"TRN-002-module-2","title":"Recognizing Suspicious Messages","order":2,"estimatedMinutes":20,"learningObjectives":["Spot suspicious indicators","Use reporting procedures"],"content":[{"type":"heading","level":2,"text":"Suspicious Messages"},{"type":"paragraph","text":"Unexpected requests for credentials, urgency, and unusual links are common warning signs."},{"type":"list","style":"unordered","items":["Verify the sender","Do not open unexpected attachments","Report suspected phishing"]}]},
        {"id":"TRN-002-module-3","title":"Reporting and Safe Handling","order":3,"estimatedMinutes":25,"learningObjectives":["Report security concerns","Handle information responsibly"],"content":[{"type":"heading","level":2,"text":"Report Concerns"},{"type":"paragraph","text":"Promptly report suspicious activity through approved organizational channels."},{"type":"callout","variant":"warning","title":"Remember","text":"Do not attempt to investigate suspicious messages yourself."}]}
      ]
    },
    {"id":"TRN-003","title":"Role-Specific Qualification","shortDescription":"Learn the responsibilities associated with an assigned position.","description":"This course supports role-specific qualification and understanding of assigned responsibilities.","category":"Role-Specific","durationMinutes":180,"difficulty":"Intermediate","prerequisites":[],"learningObjectives":["Apply role requirements","Use role-specific tools","Demonstrate qualification awareness"],"version":"1.0","modules":[{"id":"TRN-003-module-1","title":"Qualification Overview","order":1,"estimatedMinutes":60,"learningObjectives":["Describe qualification requirements"],"content":[{"type":"heading","level":2,"text":"Qualification Overview"},{"type":"paragraph","text":"Qualification requirements define the knowledge and responsibilities expected for assigned duties."}]},{"id":"TRN-003-module-2","title":"Role Responsibilities","order":2,"estimatedMinutes":60,"learningObjectives":["Apply assigned responsibilities"],"content":[{"type":"heading","level":2,"text":"Responsibilities"},{"type":"list","style":"unordered","items":["Follow role procedures","Document work","Seek supervision when needed"]}]},{"id":"TRN-003-module-3","title":"Qualification Review","order":3,"estimatedMinutes":60,"learningObjectives":["Summarize qualification outcomes"],"content":[{"type":"heading","level":2,"text":"Review"},{"type":"paragraph","text":"Review the applicable role requirements and identify any remaining learning needs."},{"type":"callout","variant":"info","title":"Completion","text":"Mark this module complete after the role qualification review is finished."}]}]},
    {"id":"TRN-004","title":"Advanced Professional Development","shortDescription":"Explore advanced technical and professional skills.","description":"This course provides additional technical and professional development opportunities.","category":"Advanced","durationMinutes":240,"difficulty":"Advanced","prerequisites":["TRN-001"],"learningObjectives":["Develop advanced professional skills","Apply structured problem-solving","Plan continued development"],"version":"1.0","modules":[{"id":"TRN-004-module-1","title":"Development Planning","order":1,"estimatedMinutes":80,"learningObjectives":["Create a development plan"],"content":[{"type":"heading","level":2,"text":"Development Planning"},{"type":"paragraph","text":"Professional development starts with clear goals and measurable activities."}]},{"id":"TRN-004-module-2","title":"Technical Practice","order":2,"estimatedMinutes":80,"learningObjectives":["Practice structured analysis"],"content":[{"type":"heading","level":2,"text":"Technical Practice"},{"type":"list","style":"unordered","items":["Define the problem","Evaluate alternatives","Record the decision"]}]},{"id":"TRN-004-module-3","title":"Professional Reflection","order":3,"estimatedMinutes":80,"learningObjectives":["Reflect on growth"],"content":[{"type":"heading","level":2,"text":"Reflection"},{"type":"paragraph","text":"Document lessons learned and identify the next development opportunity."}]}]},
    {"id":"TRN-005","title":"Annual Refresher","shortDescription":"Review recurring processes and qualification expectations.","description":"This refresher reviews applicable processes and annual qualification expectations.","category":"Refresher","durationMinutes":60,"difficulty":"Beginner","prerequisites":[],"learningObjectives":["Recall core procedures","Identify changed requirements","Complete the annual review"],"version":"1.0","modules":[{"id":"TRN-005-module-1","title":"Core Process Review","order":1,"estimatedMinutes":20,"learningObjectives":["Recall core processes"],"content":[{"type":"heading","level":2,"text":"Core Processes"},{"type":"paragraph","text":"Review your team's recurring responsibilities and required procedures."}]},{"id":"TRN-005-module-2","title":"Current Requirements","order":2,"estimatedMinutes":20,"learningObjectives":["Identify current requirements"],"content":[{"type":"heading","level":2,"text":"Requirements"},{"type":"callout","variant":"info","title":"Review","text":"Always check for the most current approved guidance."}]},{"id":"TRN-005-module-3","title":"Annual Completion","order":3,"estimatedMinutes":20,"learningObjectives":["Confirm refresher completion"],"content":[{"type":"heading","level":2,"text":"Completion"},{"type":"paragraph","text":"Confirm that you understand the applicable refresher topics and can apply them."}]}]},
    {"id":"TRN-006","title":"Fleet Operations Safety","shortDescription":"Apply safe fleet operations and equipment-readiness practices.","description":"This course covers safe operations, vehicle readiness checks, and proper use of operational equipment.","category":"Role-Specific","durationMinutes":180,"difficulty":"Intermediate","prerequisites":[],"learningObjectives":["Perform readiness checks","Apply safe operating practices","Report equipment concerns"],"version":"1.0","modules":[{"id":"TRN-006-module-1","title":"Operations Safety Basics","order":1,"estimatedMinutes":60,"learningObjectives":["Recognize operational hazards"],"content":[{"type":"heading","level":2,"text":"Safety Basics"},{"type":"list","style":"unordered","items":["Inspect the work area","Check required equipment","Stop unsafe work"]}]},{"id":"TRN-006-module-2","title":"Readiness Checks","order":2,"estimatedMinutes":60,"learningObjectives":["Complete a readiness check"],"content":[{"type":"heading","level":2,"text":"Readiness"},{"type":"paragraph","text":"Use the approved checklist before equipment or vehicles enter operation."}]},{"id":"TRN-006-module-3","title":"Reporting and Closeout","order":3,"estimatedMinutes":60,"learningObjectives":["Report concerns and close work safely"],"content":[{"type":"heading","level":2,"text":"Closeout"},{"type":"callout","variant":"warning","title":"Safety First","text":"Remove unsafe equipment from service and notify the responsible supervisor."}]}]},
    {"id":"TRN-007","title":"Recruitment and Onboarding Workflow","shortDescription":"Coordinate hiring and onboarding activities.","description":"This course presents practical workflow guidance for hiring coordination, onboarding support, and employee documentation.","category":"Role-Specific","durationMinutes":120,"difficulty":"Beginner","prerequisites":[],"learningObjectives":["Coordinate recruitment steps","Support onboarding","Protect employee documentation"],"version":"1.0","modules":[{"id":"TRN-007-module-1","title":"Recruitment Workflow","order":1,"estimatedMinutes":40,"learningObjectives":["Describe the recruitment process"],"content":[{"type":"heading","level":2,"text":"Recruitment Workflow"},{"type":"paragraph","text":"Coordinate each recruitment stage consistently and document required approvals."}]},{"id":"TRN-007-module-2","title":"Onboarding Support","order":2,"estimatedMinutes":40,"learningObjectives":["Prepare onboarding activities"],"content":[{"type":"heading","level":2,"text":"Onboarding"},{"type":"list","style":"unordered","items":["Confirm start requirements","Provide approved resources","Coordinate introductions"]}]},{"id":"TRN-007-module-3","title":"Documentation and Closeout","order":3,"estimatedMinutes":40,"learningObjectives":["Handle personnel records appropriately"],"content":[{"type":"heading","level":2,"text":"Documentation"},{"type":"paragraph","text":"Follow approved handling and retention procedures for personnel records."}]}]},
    {"id":"TRN-008","title":"IT Help Desk Fundamentals","shortDescription":"Improve service and troubleshooting fundamentals.","description":"This course introduces support techniques for troubleshooting, access requests, and service documentation.","category":"Role-Specific","durationMinutes":180,"difficulty":"Beginner","prerequisites":[],"learningObjectives":["Document support requests","Apply troubleshooting steps","Protect access information"],"version":"1.0","modules":[{"id":"TRN-008-module-1","title":"Support Requests","order":1,"estimatedMinutes":60,"learningObjectives":["Create a useful support record"],"content":[{"type":"heading","level":2,"text":"Support Requests"},{"type":"paragraph","text":"Capture the reported issue, environment, impact, and relevant troubleshooting history."}]},{"id":"TRN-008-module-2","title":"Troubleshooting Fundamentals","order":2,"estimatedMinutes":60,"learningObjectives":["Use a structured troubleshooting process"],"content":[{"type":"heading","level":2,"text":"Troubleshooting"},{"type":"list","style":"ordered","items":["Identify symptoms","Check likely causes","Apply a minimal change","Verify the result"]}]},{"id":"TRN-008-module-3","title":"Access and Documentation","order":3,"estimatedMinutes":60,"learningObjectives":["Handle access requests safely"],"content":[{"type":"heading","level":2,"text":"Access and Documentation"},{"type":"callout","variant":"warning","title":"Sensitive Information","text":"Never request or record passwords in support documentation."}]}]},
    {"id":"TRN-009","title":"Engineering Quality Standards","shortDescription":"Understand technical quality review processes.","description":"This course introduces quality review processes and technical validation standards used by engineering teams.","category":"Role-Specific","durationMinutes":180,"difficulty":"Intermediate","prerequisites":[],"learningObjectives":["Apply quality controls","Conduct structured reviews","Document validation results"],"version":"1.0","modules":[{"id":"TRN-009-module-1","title":"Quality Review Basics","order":1,"estimatedMinutes":60,"learningObjectives":["Identify quality expectations"],"content":[{"type":"heading","level":2,"text":"Quality Review"},{"type":"paragraph","text":"Quality reviews verify that work meets approved technical requirements."}]},{"id":"TRN-009-module-2","title":"Technical Validation","order":2,"estimatedMinutes":60,"learningObjectives":["Perform a technical validation"],"content":[{"type":"heading","level":2,"text":"Validation"},{"type":"list","style":"unordered","items":["Review requirements","Check evidence","Record findings"]}]},{"id":"TRN-009-module-3","title":"Review Closeout","order":3,"estimatedMinutes":60,"learningObjectives":["Document completed review outcomes"],"content":[{"type":"heading","level":2,"text":"Closeout"},{"type":"paragraph","text":"Record disposition, required corrective actions, and approval status."}]}]},
    {"id":"TRN-010","title":"Public Communications Essentials","shortDescription":"Learn consistent and audience-focused communications.","description":"This course covers core communication standards, message consistency, and audience awareness.","category":"Role-Specific","durationMinutes":120,"difficulty":"Beginner","prerequisites":[],"learningObjectives":["Identify audience needs","Apply communication standards","Maintain message consistency"],"version":"1.0","modules":[{"id":"TRN-010-module-1","title":"Audience and Purpose","order":1,"estimatedMinutes":40,"learningObjectives":["Identify target audiences"],"content":[{"type":"heading","level":2,"text":"Audience and Purpose"},{"type":"paragraph","text":"Effective communication begins by understanding the audience and intended action."}]},{"id":"TRN-010-module-2","title":"Message Consistency","order":2,"estimatedMinutes":40,"learningObjectives":["Maintain consistent messaging"],"content":[{"type":"heading","level":2,"text":"Consistent Messaging"},{"type":"list","style":"unordered","items":["Use approved facts","Define key terms","Review for accuracy"]}]},{"id":"TRN-010-module-3","title":"Review and Delivery","order":3,"estimatedMinutes":40,"learningObjectives":["Complete a final communication review"],"content":[{"type":"heading","level":2,"text":"Final Review"},{"type":"paragraph","text":"Review the message for clarity, accuracy, accessibility, and intended audience."}]}]}
  ]
